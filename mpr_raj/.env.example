# Copy to .env and fill in. Never commit the real file.

# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

DEBUG=True

DATABASE_URL=postgres://user:password@localhost:5432/mpr_raj

# Comma-separated. Required once DEBUG=False. For a LAN box add its address and
# hostname, e.g. localhost,127.0.0.1,192.168.1.42,mpr.local
ALLOWED_HOSTS=localhost,127.0.0.1

# Is this server actually reachable over TLS? Defaults to "on whenever DEBUG is
# off". Set it to False for a plain-HTTP LAN deployment — otherwise Django
# redirects every request to https:// and the site is unreachable.
HTTPS=

# Comma-separated, scheme included, e.g. https://mpr.rajasthan.gov.in
CSRF_TRUSTED_ORIGINS=

# Lockout thresholds. Cool-off is in minutes; django-environ has no duration type.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30

# Proxies in front of Django. 0 logs REMOTE_ADDR (the proxy's own address when
# there is one). Set to the real count only once nginx overwrites
# X-Forwarded-For — too high and the logged IP becomes forgeable.
AXES_IPWARE_PROXY_COUNT=0
